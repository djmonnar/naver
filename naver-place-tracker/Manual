            { label: "인원 표기", ex: "10.2인 = 어른 10명 + 어린이 2명" },
            { label: "기본 메뉴", ex: "메뉴 없이 입력 시 시그니처로 자동 설정" },
            { label: "연도 처리", ex: "10~12월에 1~3월 입력 → 내년으로 자동 저장" },
            { label: "중복 처리", ex: "같은 날짜+이름 → 자동 수정 (새로 추가 아님)" },
            { label: "혼합 메뉴", ex: "스시2 민물2 → 메뉴: 스시2+민물장어2" },
          ].map(({ label, ex }) => (
            <div key={label} className="bg-stone-50 rounded-xl border border-stone-200 p-3">
              <Tag color="bg-stone-700 text-white">{label}</Tag>
              <div className="text-xs text-stone-600 mt-1.5">{ex}</div>
            </div>
          ))}
        </div>
      </div>

      <div className="bg-rose-50 border-2 border-rose-200 rounded-2xl p-4">
        <div className="font-bold text-sm text-rose-800 mb-2">🚨 잘 안되면?</div>
        <div className="space-y-1 text-xs text-rose-700">
          <div>• 이름에 "님" 붙었는지 확인</div>
          <div>• 날짜 형식: 3/28 또는 3월28일</div>
          <div>• 시간 형식: 6:00 (콜론 필수)</div>
          <div>• 인원: 4인 (숫자+인)</div>
          <div>• 5초 안에 응답 없으면 다시 시도</div>
        </div>
      </div>
    </div>
  ),
};

export default function ReservationGuide() {
  const [active, setActive] = useState(null);

  return (
    <div className="min-h-screen bg-stone-100 pb-12" style={{ fontFamily: "'Noto Sans KR', sans-serif" }}>
      {/* Header */}
      <div className="bg-stone-900 px-5 pt-12 pb-8">
        <div className="text-amber-400 text-xs font-bold tracking-widest mb-2">YEONHAEJU</div>
        <h1 className="text-white text-2xl font-black leading-tight mb-1">
          예약 시스템<br />사용 가이드
        </h1>
        <p className="text-stone-400 text-sm">카카오 챗봇 · 네이버 예약 · 관리 페이지</p>
      </div>

      {/* Quick Links */}
      <div className="px-4 -mt-4 mb-4 grid grid-cols-3 gap-2">
        {[
          { icon: "🤖", label: "챗봇", id: "chatbot" },
          { icon: "🟢", label: "네이버", id: "naver" },
          { icon: "📋", label: "예약페이지", id: "page" },
        ].map(({ icon, label, id }) => (
          <button
            key={id}
            onClick={() => setActive(active === id ? null : id)}
            className="bg-white rounded-2xl py-3 flex flex-col items-center gap-1 shadow-sm border-2 border-white active:bg-stone-50"
          >
            <span className="text-xl">{icon}</span>
            <span className="text-xs font-bold text-stone-700">{label}</span>
          </button>
        ))}
      </div>

      {/* Sections */}
      <div className="px-4 space-y-3">
        {sections.map((sec) => {
          const isOpen = active === sec.id;
          return (
            <div
              key={sec.id}
              className={`rounded-3xl overflow-hidden border-2 transition-all ${sec.border} bg-white`}
            >
              <button
                onClick={() => setActive(isOpen ? null : sec.id)}
                className="w-full flex items-center gap-3 px-5 py-4"
              >
                <div
                  className={`w-10 h-10 rounded-2xl bg-gradient-to-br ${sec.color} flex items-center justify-center text-xl shrink-0`}
                >
                  {sec.emoji}
                </div>
                <div className="flex-1 text-left">
                  <div className="font-black text-sm text-stone-900">{sec.title}</div>
                </div>
                <div
                  className={`w-6 h-6 rounded-full bg-stone-100 flex items-center justify-center text-stone-400 text-xs transition-transform ${
                    isOpen ? "rotate-180" : ""
                  }`}
                >
                  ▼
                </div>
              </button>

              {isOpen && (
                <div className={`px-4 pb-5 pt-1 ${sec.bg} border-t ${sec.border}`}>
                  {contents[sec.content]}
                </div>
              )}
            </div>
          );
        })}
      </div>

      {/* Footer */}
      <div className="px-4 mt-6">
        <div className="bg-stone-800 rounded-3xl p-5 text-center">
          <div className="text-2xl mb-2">🙋</div>
          <div className="text-white font-bold text-sm mb-1">모르는 게 있으면?</div>
          <div className="text-stone-400 text-xs leading-relaxed">
            예약 관리 페이지에서 직접 수정하거나<br />
            매니저에게 문의해주세요
          </div>
        </div>
      </div>
    </div>
  );
}
