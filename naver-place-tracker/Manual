function FlowArrow() {
  return (
    <div className="flex justify-center my-1">
      <div className="w-0.5 h-5 bg-stone-300 relative">
        <div className="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 border-b-2 border-r-2 border-stone-400 rotate-45" />
      </div>
    </div>
  );
}

function FlowBox({ icon, label, sub, color = "bg-white border-stone-200" }) {
  return (
    <div className={`rounded-2xl border-2 px-4 py-3 flex items-center gap-3 ${color}`}>
      <span className="text-2xl">{icon}</span>
      <div>
        <div className="font-bold text-sm text-stone-800">{label}</div>
        {sub && <div className="text-xs text-stone-500 mt-0.5">{sub}</div>}
      </div>
    </div>
  );
}

function Tag({ children, color = "bg-stone-100 text-stone-600" }) {
  return (
    <span className={`inline-block text-xs px-2.5 py-1 rounded-full font-semibold ${color}`}>
      {children}
    </span>
  );
}

function Step({ num, title, desc, tip }) {
  return (
    <div className="flex gap-3">
      <div className="w-7 h-7 rounded-full bg-stone-800 text-white text-xs font-black flex items-center justify-center shrink-0 mt-0.5">
        {num}
      </div>
      <div className="flex-1 pb-4 border-b border-stone-100 last:border-0">
        <div className="font-bold text-sm text-stone-800">{title}</div>
        <div className="text-sm text-stone-600 mt-1 leading-relaxed">{desc}</div>
        {tip && (
          <div className="mt-2 bg-amber-50 border border-amber-200 rounded-xl px-3 py-2 text-xs text-amber-800">
            💡 {tip}
          </div>
        )}
      </div>
    </div>
  );
}

function ChatBubble({ who, text, isBot }) {
  return (
    <div className={`flex ${isBot ? "justify-start" : "justify-end"} mb-2`}>
      {isBot && (
        <div className="w-7 h-7 rounded-full bg-yellow-400 flex items-center justify-center text-sm mr-2 shrink-0 mt-0.5">
          🤖
        </div>
      )}
      <div
        className={`max-w-[80%] px-3.5 py-2.5 rounded-2xl text-sm leading-relaxed ${
          isBot
            ? "bg-white border border-stone-200 text-stone-800 rounded-tl-sm"
            : "bg-yellow-400 text-stone-900 rounded-tr-sm"
        }`}
      >
        {text}
      </div>
    </div>
  );
}

function MenuPill({ name, icon, desc }) {
  return (
    <div className="flex items-center gap-3 py-2.5 border-b border-stone-100 last:border-0">
      <span className="text-xl">{icon}</span>
      <div>
        <span className="font-bold text-sm text-stone-800">{name}</span>
        <span className="text-xs text-stone-400 ml-2">{desc}</span>
      </div>
    </div>
  );
}

function CodeBlock({ children }) {
  return (
    <div className="bg-stone-900 rounded-2xl px-4 py-3 text-xs text-green-400 font-mono leading-relaxed mt-2">
      {children}
    </div>
  );
}

