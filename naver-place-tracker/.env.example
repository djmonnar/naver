# Local mode keeps the current SQLite behavior.
# Set DATA_BACKEND=firestore when Firebase/Firestore is ready.
DATA_BACKEND=sqlite

# Enable Firebase login/session protection.
# DATA_BACKEND=firestore enables auth by default, but this is explicit for clarity.
FIREBASE_AUTH_ENABLED=false

# Firebase Web app config, copied from Firebase console > Project settings > Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin credentials for the FastAPI server.
# Use one of these:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_FILE=/app/data/firebase-service-account.json

# Production cookies should be Secure on HTTPS hosting.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DAYS=5

# Existing SQLite fallback path.
DB_PATH=tracker.db
RES_DB=reservations.db
