# Firebase mode stores tracker data in Firestore per authenticated user.
# For old local-only testing, change this to sqlite and FIREBASE_AUTH_ENABLED=false.
DATA_BACKEND=firestore

# Enable Firebase Google login/session protection.
FIREBASE_AUTH_ENABLED=true

# Firebase Web app config, copied from Firebase console > Project settings > Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin credentials for the FastAPI server and GitHub Actions crawler.
# Use one of these:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_FILE=/app/data/firebase-service-account.json

# Production cookies should be Secure on HTTPS hosting.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DAYS=5

# SQLite fallback path.
DB_PATH=tracker.db
